    "context": {
      "type": "object"
    },
    "expected_gate": {
      "enum": [
        "normal",
        "uncertain",
        "confirmed",
        "cleared",
        "handoff"
      ]
    },
    "expected_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "maxItems": 3
    },
    "expected_result_kind": {
      "enum": [
        "response",
        "action_result",
        "clarification",
        "insufficient",
        "human_help",
        "out_of_scope"
      ]
    },
    "expected_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 3
    },
    "expected_s0_events": {
      "type": "array",
      "items": {
        "enum": [
          "RISK_UNCERTAIN",
          "RISK_CONFIRMED",
          "RISK_CLEARED",
          "HUMAN_HANDOFF",
          "PAUSE_ASSISTANT",
          "SPEECH_STOP",
          "ASK_CLARIFICATION"
        ]
      },
      "uniqueItems": true
    },
    "should_classify": {
      "type": "boolean"
    },
    "should_execute_actions": {
      "type": "boolean"
    },
    "expected_b3": {
      "enum": [
        "PRESENTE",
        "ORIENTAR",
        "TRANSICIÓN",
        "PAUSA",
        "CONFIRMAR"
      ]
    },
    "ambiguity": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
