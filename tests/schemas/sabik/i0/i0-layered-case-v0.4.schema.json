  "properties": {
    "id": {
      "type": "string",
      "pattern": "^I0-(DEV|CAL)-[0-9]{4}$"
    },
    "dataset_role": {
      "enum": [
        "development",
        "calibration"
      ]
    },
    "locale": {
      "enum": [
        "es",
        "en"
      ]
    },
    "utterance": {
      "type": "string",
      "minLength": 1
