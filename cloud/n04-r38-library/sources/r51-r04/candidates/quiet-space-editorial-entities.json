    {
      "entity_id": "quiet-space:m-04:en",
      "content_id": "quiet-space:m-04",
      "fragment_id": "quiet-space:m-04:en:main",
      "locale": "en",
      "content_type": "quiet_space",
      "title": "If you need a person now",
      "heading": "M-04",
      "text": "These services are in Spain.\nIf you or someone else is in danger right now: 112.\nEmergencies. Free.\nIf you are having thoughts of suicide, or you are worried about someone: 024.\nFree and confidential, any time. Also by chat and in sign language.\nIf you need to talk to someone: Teléfono de la Esperanza, 717 003 717.\nIf you are under 18: Fundación ANAR, 900 20 20 10.\nFree and confidential. There is also a chat.\nIf you are outside Spain, use your local emergency services.\nThis site does not know whether you call, or whom.\nClose",
      "canonical_url": "https://irisgreen.eu/en/quiet-space/",
      "source_type": "quiet_space_crisis_help",
