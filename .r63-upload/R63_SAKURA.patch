+# -*- coding: utf-8 -*-
+"""
+R63 · SAKURA · CIERRE DE RUNTIME
+Comprobaciones 1-8 de la orden, sobre la PAGINA REAL, no sobre el banco.
+Cada una imprime PASA o FALLA con el dato que lo sostiene.
+"""
+import asyncio, json, os, sys
+from playwright.async_api import async_playwright
+
+BASE = 'http://127.0.0.1:8732'
+SALIDA = '/home/claude/r63/qa'
+os.makedirs(SALIDA, exist_ok=True)
+
+# Cuenta los requestAnimationFrame desde antes de que corra un solo script
+GANCHO = """
+window.__raf = 0;
+(function () {
+  var o = window.requestAnimationFrame;
+  window.requestAnimationFrame = function (f) { window.__raf++; return o.call(window, f); };
+})();
+window.__net = [];
+"""
+
+RES = []
+def anota(nom, ok, dato):
+    RES.append({'check': nom, 'ok': bool(ok), 'dato': dato})
+    print(('  PASA  ' if ok else '  FALLA ') + nom + '  ::  ' + str(dato))
+
+
+async def abrir(br, ruta='/es/sitio-tranquilo/', w=1000, h=780, gancho=True, red=False):
+    pg = await br.new_page(viewport={'width': w, 'height': h})
+    if not red:
+        # sin esto, cada captura espera a fonts.googleapis.com y se agota
+        await pg.route('**://fonts.googleapis.com/**', lambda r: asyncio.ensure_future(r.abort()))
+        await pg.route('**://fonts.gstatic.com/**', lambda r: asyncio.ensure_future(r.abort()))
+    if gancho:
+        await pg.add_init_script(GANCHO)
+    peticiones = []
+    pg.on('request', lambda r: peticiones.append(r.url))
+    consola = []
+    pg.on('console', lambda m: consola.append(m.type + ':' + m.text))
+    pg.on('pageerror', lambda e: consola.append('pageerror:' + str(e)))
+    await pg.goto(BASE + ruta, wait_until='load')
+    pg._peticiones = peticiones
+    pg._consola = consola
+    return pg
+
+
+async def tirar(pg, sel='#r46RoomStage'):
+    """Captura de un canvas VIVO. locator.screenshot() espera a que el elemento
+    se estabilice, y un canvas animado no se estabiliza nunca: se cuelga y, de
+    paso, devuelve fotogramas identicos. Con recorte de pagina no hay espera."""
+    loc = pg.locator(sel)
+    try:
+        await loc.scroll_into_view_if_needed(timeout=4000)
+    except Exception:
+        pass
+    caja = await loc.bounding_box()
+    if not caja or caja['width'] < 8 or caja['height'] < 8:
+        return None
+    vp = pg.viewport_size or {'width': 1280, 'height': 900}
+    x = max(0, min(caja['x'], vp['width'] - 10))
+    y = max(0, min(caja['y'], vp['height'] - 10))
+    w = max(10, min(caja['width'], vp['width'] - x))
+    h = max(10, min(caja['height'], vp['height'] - y))
+    # el rasterizador por software va lento mientras anima: capturar pide tiempo
+    return await pg.screenshot(clip={'x': x, 'y': y, 'width': w, 'height': h},
+                               timeout=120000)
+
+
+async def pulsar(pg, sel):
+    await pg.click(sel, timeout=90000)
+
+
+async def entrar_sala(pg, mov=None, sala='sakura'):
+    await pulsar(pg, '#r46-tab-room')
+    await pulsar(pg, 'button[data-r46-room="%s"]' % sala)
+    if mov:
+        await pg.select_option('#r46RoomMotion', mov)
+    await pulsar(pg, '#r46RoomStart')
+    await pg.wait_for_timeout(2800)
+
+
+# ----------------------------------------------------------------- 1 y 2
+async def c1_evidencia_y_raf(br):
+    """Solo el conteo de RAF. La evidencia de movimiento va en evidencia.py:
+    aqui no se puede medir, porque el contexto de produccion se crea con
+    preserveDrawingBuffer:false y la captura del compositor devuelve fotogramas
+    cacheados (lo comprobe: t=10 y t=200 salian identicos byte a byte)."""
+    print('\n[2] SIN_MOVIMIENTO = 0 RAF continuo   (la evidencia visual va en evidencia.py)')
+    for mov in ('normal', 'reducido', 'quieto'):
+        pg = await abrir(br)
+        await entrar_sala(pg, mov)
+        n0 = await pg.evaluate('window.__raf')
+        await pg.wait_for_timeout(3500)
+        n1 = await pg.evaluate('window.__raf')
+        if mov == 'quieto':
+            anota('SIN_MOVIMIENTO: 0 RAF continuo tras pintar', (n1 - n0) == 0,
+                  'RAF en 3,5 s = %d' % (n1 - n0))
+        else:
+            anota('%s: el bucle corre' % mov.upper(), (n1 - n0) > 10,
+                  'RAF en 3,5 s = %d' % (n1 - n0))
+        await pg.close()
+
+
+# ------------------------------------------------------- 2b estructural
+async def c2b_reducido_estructural(br):
+    """Astra bloqueo que REDUCIDO fuese la misma escena multiplicada. Aqui no se
+    mide la sensacion: se cuenta lo que se dibuja de verdad, enganchando
+    drawArrays y leyendo los uniforms."""
+    print('\n[2b] REDUCIDO tiene diferencia estructural, no solo multiplicador')
+    datos = {}
+    for mov in ('normal', 'reducido'):
+        pg = await abrir(br)
+        await pg.add_init_script("""
+          (function(){
+            window.__draw = {};
+            var P = WebGL2RenderingContext && WebGL2RenderingContext.prototype;
+            if(!P) return;
+            var o = P.drawArrays;
+            P.drawArrays = function(m, f, c){
+              window.__draw[c] = (window.__draw[c] || 0) + 1;
+              return o.apply(this, arguments);
+            };
+          })();
+        """)
+        await pg.goto(BASE + '/es/sitio-tranquilo/', wait_until='load')
+        await entrar_sala(pg, mov)
+        # se pone el contador a cero DESPUES de arrancar: al elegir la sala se
+        # pinta un fotograma con el nivel por defecto y ese contaminaba la cuenta
+        await pg.evaluate("window.__draw = {}")
+        await pg.wait_for_timeout(2000)
+        d = await pg.evaluate("JSON.stringify(window.__draw)")
+        datos[mov] = {int(k): v for k, v in json.loads(d).items()}
+        await pg.close()
+
+    # los petalos se dibujan con 6 vertices por instancia
+    def petalos(m):
+        cand = [c for c in datos[m] if c % 6 == 0 and 60 <= c // 6 <= 400]
+        return max(cand) // 6 if cand else None
+    pn, pr = petalos('normal'), petalos('reducido')
+    anota('REDUCIDO dibuja menos instancias de petalo', pn and pr and pr < pn,
+          'NORMAL %s petalos por fotograma, REDUCIDO %s' % (pn, pr))
+    anota('La reduccion de poblacion es sustancial, no cosmetica',
+          pn and pr and (pr / pn) < 0.5,
+          'REDUCIDO dibuja el %.0f%% de las instancias' % (100.0 * pr / pn) if pn and pr else 'sin datos')
+
+
+# ------------------------------------------------------------------- 3
+async def c3_tiers(br):
+    print('\n[3] Escalones reales, sin declarar ninguno vacio')
+    pg = await abrir(br)
+    await pulsar(pg, '#r46-tab-room')
+    await pulsar(pg, 'button[data-r46-room="sakura"]')
+    await pulsar(pg, '#r46RoomStart')
+    await pg.wait_for_timeout(2500)
+    motores_json = await pg.evaluate("JSON.stringify((window.IGRincon46 && window.IGRincon46.engines && window.IGRincon46.engines()) || null)")
+    mj = json.loads(motores_json) if motores_json and motores_json != 'null' else {}
+    sala = (mj.get('rooms') or {}).get('tier', 'sin sonda')
+    gpu = await pg.evaluate("!!navigator.gpu")
+    motores = await pg.evaluate("""(()=>{
+      const t=document.getElementById('r46BreathEngine');
+      return t ? t.textContent : '';
+    })()""")
+    resp = (mj.get('breath') or {})
+    anota('Salas: el escalon servido es real y no es A', sala in ('B', 'C', 'D'),
+          'Salas -> %s (A no existe en Salas y no se declara)' % sala)
+    anota('Respirar: el escalon declarado corresponde a un motor implementado',
+          resp.get('tier') in ('A', 'B', 'C', 'D'),
+          'Respirar -> %s / %s ; navigator.gpu presente: %s ; rotulo en pantalla: "%s"'
+          % (resp.get('tier'), resp.get('label'), gpu, (motores or '').strip()))
+    await pg.close()
+
+
+# ------------------------------------------------------------------- 4
+async def c4_shader_falla(br):
+    print('\n[4] Fallo de compilacion de shader: diagnostico, no pantalla vacia')
+    pg = await abrir(br)
+    # se rompe la compilacion de TODO shader antes de que corra el stage
+    await pg.add_init_script("""
+      (function(){
+        const P = WebGL2RenderingContext && WebGL2RenderingContext.prototype;
+        if(!P) return;
+        const o = P.compileShader;
+        P.compileShader = function(s){ o.call(this,s); };
+        const gp = P.getShaderParameter;
+        P.getShaderParameter = function(s,p){
+          if(p===this.COMPILE_STATUS) return false;
+          return gp.call(this,s,p);
+        };
+        const gl2 = P.getShaderInfoLog;
+        P.getShaderInfoLog = function(s){ return 'FALLO INYECTADO PARA LA PRUEBA'; };
+      })();
+    """)
+    await pg.goto(BASE + '/es/sitio-tranquilo/', wait_until='load')
+    await entrar_sala(pg)
