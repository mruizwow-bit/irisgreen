+# -*- coding: utf-8 -*-
+"""Renderiza el LEEME del handoff desde datos reales. Aborta si algo no cuadra."""
+import json, os, subprocess, sys, datetime
+
+dest, base, head = sys.argv[1], sys.argv[2], sys.argv[3]
+repo = '/home/claude/wt-r46'
+A2 = 'origin/agent2/sabik-iris-r08-20260924'
+
+def g(*a):
+    return subprocess.check_output(['git', '-C', repo] + list(a), text=True).strip()
+
+man = json.load(open(os.path.join(dest, 'MANIFIESTO.json')))
+mios = set(g('diff', '--name-only', base, head).splitlines())
+suyos = set(g('diff', '--name-only', base, A2).splitlines())
+fusion = subprocess.run(['git', '-C', repo, 'merge-tree', '--write-tree', A2, head],
+                        capture_output=True)
+
+def carga(r):
+    p = os.path.join(dest, r)
+    return json.load(open(p)) if os.path.exists(p) else None
+
+rt = carga('qa/runtime.json') or []
+a11y = carga('qa/a11y/a11y.json') or []
+ev = (carga('qa/evidencia/evidencia_r2.json') or {})
+evc = ev.get('checks', [])
+niv = ev.get('niveles', {})
+
+def cuenta(lista):
+    return len(lista), sum(1 for x in lista if not x['ok'])
+rt_n, rt_f = cuenta(rt)
+a_n, a_f = cuenta(a11y)
+e_n, e_f = cuenta(evc)
+
+v = {
+    'FECHA': datetime.date.today().strftime('%d/%m/%Y'),
+    'RAMA': man['rama'], 'BASE': base, 'HEAD': head,
+    'COMMITS': str(man['commits']), 'FICHEROS': str(len(mios)),
+    'FICHEROS_A2': str(len(suyos)), 'SOLAPE': str(len(mios & suyos)),
+    'FUSION': 'limpia, sin conflictos' if fusion.returncode == 0 else 'CON CONFLICTOS',
+    'N_PAQUETE': str(len(man['ficheros'])),
+    'QA_TOTAL': str(rt_n + a_n + e_n), 'QA_FALLAN': str(rt_f + a_f + e_f),
+    'QA_PASAN': str((rt_n + a_n + e_n) - (rt_f + a_f + e_f)),
+    'RT_TOTAL': str(rt_n), 'RT_FALLAN': str(rt_f),
+    'A11Y_TOTAL': str(a_n), 'A11Y_FALLAN': str(a_f),
+    'EV_TOTAL': str(e_n), 'EV_FALLAN': str(e_f),
+}
+for k, nom in (('normal', 'NORMAL'), ('reducido', 'REDUCIDO'), ('quieto', 'QUIETO')):
+    d = niv.get(k, {})
+    v['V_%s_DUR' % nom] = '%.1f' % d.get('duracion', 0)
+    v['V_%s_N' % nom] = str(d.get('fotogramas', 0))
+    v['V_%s_PIX' % nom] = '%.3f' % d.get('pix6', 0)
+    v['V_%s_REC' % nom] = '%.2f' % d.get('recorrido', 0)
+
+# comprobaciones de coherencia: si algo no cuadra, no se entrega
+fallos = []
+if man['commits'] != int(g('rev-list', '--count', base + '..' + head)):
+    fallos.append('el numero de commits del manifiesto no cuadra con el repositorio')
+if man['head'] != head:
+    fallos.append('la cabeza del manifiesto no cuadra')
+if len(mios & suyos) != man['fusion_de_prueba_contra_A2']['solape']:
+    fallos.append('el solape no cuadra con el manifiesto')
+if fusion.returncode != 0:
+    fallos.append('la fusion de prueba contra A2 ya no es limpia')
+if not niv:
+    fallos.append('faltan las medidas de evidencia temporal')
+
+txt = open('/home/claude/r63/LEEME.plantilla.md').read()
+for k, val in v.items():
+    txt = txt.replace('{{%s}}' % k, val)
+import re
+sobran = re.findall(r'\{\{[A-Z_]+\}\}', txt)
+if sobran:
+    fallos.append('quedan huecos sin rellenar en el LEEME: ' + ', '.join(sorted(set(sobran))))
+if fallos:
+    print('NO SE ENTREGA. El handoff no es coherente:')
+    for f in fallos:
+        print('  - ' + f)
+    sys.exit(1)
+open(os.path.join(dest, 'LEEME.md'), 'w').write(txt)
+print('LEEME generado: %s commits, %s ficheros, QA %s/%s' %
+      (v['COMMITS'], v['FICHEROS'], v['QA_PASAN'], v['QA_TOTAL']))
