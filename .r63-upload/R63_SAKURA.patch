@@ -0,0 +1,171 @@
+# -*- coding: utf-8 -*-
+"""
+IRIS GREEN . R63 . SAKURA . GENERADOR DE DOSEL (fuera de linea)
+
+Hornea los masters first-party de la proyeccion de cerezo. No es codigo de
+runtime: se ejecuta aqui y lo que viaja a la web son las imagenes.
+
+Lo que construye, que es justo lo que el procedural por fragmento no daba:
+  - esqueleto de ramas con bifurcaciones y afinado real,
+  - racimos de flor colgando de las ultimas generaciones, no repartidos,
+  - tres planos de profundidad con escala, contraste y foco distintos,
+  - huecos de cielo de verdad.
+
+La pared se genera PERIODICA en horizontal (todo se dibuja en x, x-W y x+W),
+asi que cierra alrededor del cilindro sin costura.
+"""
+import math, random
+from PIL import Image, ImageDraw, ImageFilter
+
+# ---------------------------------------------------------------- paletas
+# Medidas por agrupacion de color (k-medias, 3 grupos) sobre la referencia
+# aprobada por Maria, zona a zona y clima a clima.
+PAL = {
+    'navy': {
+        'cielo':  [(0x22, 0x15, 0x4c), (0x31, 0x1d, 0x60), (0x3e, 0x28, 0x74)],
+        'rama':   (0x14, 0x0c, 0x26),
+        'ramaA':  212,
+        'flor':   [(0xc4, 0x4d, 0x96), (0xdd, 0x6e, 0xb0), (0xed, 0x95, 0xc6),
+                   (0xf6, 0xba, 0xdb), (0xfc, 0xdd, 0xee)],
+        'centro': (0xff, 0xf0, 0xc8),
+        'lejos':  0.62,
+    },
+    'light': {
+        'cielo':  [(0xa6, 0xc5, 0xe5), (0xcd, 0xd7, 0xe8), (0xf0, 0xdc, 0xe1)],
+        'rama':   (0x5e, 0x3c, 0x44),
+        'ramaA':  190,
+        'flor':   [(0xef, 0x9c, 0xb4), (0xf6, 0xb6, 0xc6), (0xfa, 0xcd, 0xd6),
+                   (0xfd, 0xe3, 0xe8), (0xff, 0xf3, 0xf5)],
+        'centro': (0xff, 0xe6, 0xb4),
+        'lejos':  0.50,
+    },
+}
+
+
+def mezcla(a, b, t):
+    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))
+
+
+# ------------------------------------------------------------ flor suelta
+def sprite_flor(col, centro, lado=150, semilla=0):
+    """Flor de cinco petalos con muesca en la punta, sombreado propio y
+    estambres. Se pre-dibuja una vez y despues se pega miles de veces."""
+    rnd = random.Random(semilla)
+    F = 4
+    L = lado * F
+    rgb = Image.new('RGB', (L, L), col)
+    a = Image.new('L', (L, L), 0)
+    da = ImageDraw.Draw(a)
+    drgb = ImageDraw.Draw(rgb)
+    cx = cy = L / 2.0
+    R = L * 0.46
+    giro = rnd.uniform(0, math.tau)
+    aplas = rnd.uniform(0.84, 1.0)
+    for k in range(5):
+        ang = giro + k * math.tau / 5.0 + rnd.uniform(-0.10, 0.10)
+        rr = R * rnd.uniform(0.86, 1.0)
+        px = cx + math.cos(ang) * rr * 0.56
+        py = cy + math.sin(ang) * rr * 0.56 * aplas
+        pw, ph = rr * 0.58, rr * 0.42
+        pet = Image.new('L', (L, L), 0)
+        dp = ImageDraw.Draw(pet)
+        dp.ellipse([px - pw, py - ph, px + pw, py + ph], fill=255)
+        # muesca: el petalo de cerezo esta hendido en la punta
+        mx = cx + math.cos(ang) * rr * 1.04
+        my = cy + math.sin(ang) * rr * 1.04 * aplas
+        dp.ellipse([mx - ph * 0.55, my - ph * 0.55, mx + ph * 0.55, my + ph * 0.55], fill=0)
+        a.paste(255, (0, 0), pet)
+        drgb.ellipse([px - pw * 0.52, py - ph * 0.52, px + pw * 0.52, py + ph * 0.52],
+                     fill=mezcla(col, (0, 0, 0), 0.14))
+    # corazon
+    r0 = R * 0.17
+    drgb.ellipse([cx - r0, cy - r0, cx + r0, cy + r0], fill=mezcla(col, centro, 0.35))
+    for k in range(9):
+        ang = rnd.uniform(0, math.tau)
+        d2 = R * rnd.uniform(0.16, 0.40)
+        ex = cx + math.cos(ang) * d2
+        ey = cy + math.sin(ang) * d2
+        r1 = R * 0.05
+        drgb.ellipse([ex - r1, ey - r1, ex + r1, ey + r1], fill=centro)
+        da.ellipse([ex - r1, ey - r1, ex + r1, ey + r1], fill=255)
+    rgb = rgb.resize((lado, lado), Image.LANCZOS)
+    a = a.resize((lado, lado), Image.LANCZOS).filter(ImageFilter.GaussianBlur(0.5))
+    return rgb, a
+
+
+def sprite_capullo(col, lado=110, semilla=0):
+    """Capullo cerrado: da variedad y evita que todo sean estrellas de cinco."""
+    rnd = random.Random(semilla)
+    F = 4
+    L = lado * F
+    rgb = Image.new('RGB', (L, L), mezcla(col, (0, 0, 0), 0.10))
+    a = Image.new('L', (L, L), 0)
+    da = ImageDraw.Draw(a)
+    cx = cy = L / 2.0
+    R = L * 0.30
+    for k in range(3):
+        ang = rnd.uniform(0, math.tau)
+        px = cx + math.cos(ang) * R * 0.32
+        py = cy + math.sin(ang) * R * 0.32
+        da.ellipse([px - R * 0.74, py - R * 0.92, px + R * 0.74, py + R * 0.92], fill=255)
+    rgb = rgb.resize((lado, lado), Image.LANCZOS)
+    a = a.resize((lado, lado), Image.LANCZOS).filter(ImageFilter.GaussianBlur(0.7))
+    return rgb, a
+
+
+# ------------------------------------------------------------------ capa
+class Capa(object):
+    """Un plano de profundidad: color + alfa. Si tiene periodo, todo se pega
+    tambien en x-periodo y x+periodo, que es lo que cierra la pared."""
+
+    def __init__(self, w, h, periodo=None):
+        self.w, self.h = w, h
+        self.rgb = Image.new('RGB', (w, h), (0, 0, 0))
+        self.a = Image.new('L', (w, h), 0)
+        self.periodo = periodo
+        self.mask = Image.new('L', (w, h), 0)
+        self.dm = ImageDraw.Draw(self.mask)
+        self._blanco = Image.new('L', (w, h), 255)
+
+    def _offs(self, x, margen):
+        if not self.periodo:
+            return (0,)
+        if x < margen:
+            return (0, self.periodo)
+        if x > self.w - margen:
+            return (0, -self.periodo)
+        return (0,)
+
+    def linea(self, p0, p1, ancho):
+        m = max(abs(p1[0] - p0[0]), 0) + ancho * 2 + 48
+        for off in self._offs(min(p0[0], p1[0]), m):
+            self.dm.line([(p0[0] + off, p0[1]), (p1[0] + off, p1[1])],
+                         fill=255, width=max(1, int(round(ancho))))
+            r = ancho / 2.0
+            if r > 1.1:
+                self.dm.ellipse([p1[0] + off - r, p1[1] - r,
+                                 p1[0] + off + r, p1[1] + r], fill=255)
+
+    def cerrar_ramas(self, color, alfa):
+        m = self.mask
+        if alfa < 255:
+            m = m.point(lambda v: v * alfa // 255)
+        self.rgb.paste(color, (0, 0), m)
+        self.a.paste(self._blanco, (0, 0), m)
+        self.mask = Image.new('L', (self.w, self.h), 0)
+        self.dm = ImageDraw.Draw(self.mask)
+
+    def flor(self, spr, cx, cy, tam, giro):
+        rgb, a = spr
+        s = max(5, int(tam))
+        r2 = rgb.resize((s, s), Image.BILINEAR).rotate(giro, resample=Image.BILINEAR,
+                                                       expand=False)
+        a2 = a.resize((s, s), Image.BILINEAR).rotate(giro, resample=Image.BILINEAR,
+                                                     expand=False)
+        for off in self._offs(cx, s + 10):
+            x = int(cx + off - s / 2)
+            y = int(cy - s / 2)
+            if x > self.w or x + s < 0 or y > self.h or y + s < 0:
+                continue
+            self.rgb.paste(r2, (x, y), a2)
+            self.a.paste(255, (x, y), a2)
