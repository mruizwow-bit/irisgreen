      "action": "route",
      "capability": "general_knowledge"
    },
    {
      "id": "information.supports_contextual",
      "priority": 89,
      "patterns": [
        "^(?:que ayuda|qué ayuda)(?:\\s+(?:con|para)\\s+(?<detail>.+))?$"
      ],
      "fixed_slots": {
        "aspect": "supports"
      },
      "action": "retrieve"
    }
  ],
