{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irisgreen.eu/schemas/sabik/i0/layered-case-v0.4.json",
  "title": "Sabik I0 v0.4 layered development/calibration case V2",
  "type": "object",
  "required": [
    "id",
    "dataset_role",
    "locale",
    "utterance",
    "context",
    "expected_gate",
    "expected_commands",
    "expected_result_kind",
