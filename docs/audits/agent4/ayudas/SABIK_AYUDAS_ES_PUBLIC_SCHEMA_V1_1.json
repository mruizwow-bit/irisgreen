{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irisgreen.eu/schema/sabik-ayudas-public-v1-1.json",
  "title": "SABIK Ayudas · public data model V1.1",
  "description": "Contrato público lossless para la migración de Ayudas ES. migration_decision y otros metadatos de gobernanza quedan fuera del objeto público.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "country_code",
    "country_name",
    "jurisdiction",
    "jurisdiction_level",
    "scope",
    "category",
    "resource_type",
    "record_kind",
    "status",
    "program_id",
    "call_id",
    "opens_at",
    "closes_at",
    "official_url",
    "previous_url",
    "reviewed_at",
    "next_review_at",
    "source_authority",
    "source_is_primary",
    "summary",
    "eligibility_summary",
    "what_it_offers",
    "amount_summary",
    "documents_summary",
    "compatibility_notes",
    "keywords"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "country_name": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction_level": {
      "type": "string",
      "minLength": 1,
      "description": "Conserva legacy nivel sin pérdida."
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "Conserva legacy ambito sin pérdida."
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "beca",
        "bonificación",
        "deducción",
        "derecho subjetivo",
        "prestación",
        "programa",
        "recurso informativo",
        "servicio",
        "subvención"
      ]
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "PROGRAM",
        "CALL",
        "RESOURCE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ABIERTO",
        "CERRADO",
        "PERMANENTE",
        "PRÓXIMA CONVOCATORIA",
        "HISTÓRICO",
        "POR VERIFICAR"
      ]
    },
    "program_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "PROGRAM: obligatorio y normalmente coincide con id. CALL: obligatorio. RESOURCE: null salvo vínculo explícito y gobernado a un programa."
    },
    "call_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "CALL: obligatorio. PROGRAM y RESOURCE: null."
    },
    "opens_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "closes_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    },
    "previous_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Solo se rellena cuando un cambio de URL haya sido aprobado y aplicado. I2 no aplica ninguno."
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "next_review_at": {
      "type": "string",
      "format": "date"
    },
    "source_authority": {
      "type": "string",
      "minLength": 1
    },
    "source_is_primary": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "eligibility_summary": {
      "type": "string",
      "minLength": 1
    },
    "what_it_offers": {
      "type": "string",
      "minLength": 1,
      "description": "En I2 se rellena de forma controlada con el contenido legacy de cuantia para no introducir afirmaciones nuevas."
    },
    "amount_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Conserva legacy cuantia exactamente."
    },
    "documents_summary": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_notes": {
      "type": "string",
      "minLength": 1,
      "description": "Conserva legacy obs exactamente."
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Transformación reversible de legacy tags separado por coma."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "PROGRAM"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "call_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "CALL"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "program_id": {
            "type": "string",
            "minLength": 1
          },
          "call_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "RESOURCE"
          }
        },
        "required": [
          "record_kind"
        ]
      },
      "then": {
        "properties": {
          "program_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "call_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ABIERTO"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "closes_at": {
            "type": "string",
            "format": "date"
          },
          "source_is_primary": {
            "const": true
          }
        }
      }
    }
  ]
}
