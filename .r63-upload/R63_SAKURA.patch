+body.r46-clean .ig-r42-topbar,
+body.r46-clean .ig-r42-context,
+body.r46-clean .ig-r42-rail,
+body.r46-clean .ig-r42-inspector { display: none !important; }
+body.r46-clean .ig-r42-shell {
+  margin: 0; border: 0; border-radius: 0; box-shadow: none;
+  width: 100%; max-width: none;
+}
+body.r46-clean .ig-r42-body { display: block; }
+body.r46-clean .ig-r42-workspace {
+  padding: 0; border: 0; border-radius: 0; min-height: 0; overflow: visible; background: var(--ig-bg-surface);
+}
+body.r46-clean .ig-r42-stage {
+  padding: 0; border: 0; border-radius: 0; box-shadow: none; min-height: 0; overflow: visible;
+}
+body.r46-clean .ig-r42-stage > #r40Workspace { padding: 0; }
