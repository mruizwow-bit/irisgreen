+    await pg.wait_for_timeout(600)
+    d = await pg.evaluate("""(()=>{
+      const p = document.getElementById('r46Rooms');
+      const bs = [...p.querySelectorAll('button')].filter(e => e.offsetParent !== null);
+      const invis = bs.filter(e => {
+        const s = getComputedStyle(e);
+        return s.visibility === 'hidden' || s.opacity === '0';
+      }).length;
+      return { activo: matchMedia('(forced-colors: active)').matches,
+               botones: bs.length, invisibles: invis,
+               texto: (p.innerText || '').trim().length };
+    })()""")
+    anota('forced-colors activo y el panel sigue legible',
+          d['activo'] and d['invisibles'] == 0 and d['texto'] > 80,
+          'activo %s, %d botones, %d invisibles, %d caracteres de texto'
+          % (d['activo'], d['botones'], d['invisibles'], d['texto']))
+    await pg.screenshot(path=OUT + '/forced_colors.png')
+    await ctx.close()
+
+
+# ------------------------------------------ movimiento reducido del sistema
+async def c_prefiere_menos(br):
+    print('\n[9e] prefers-reduced-motion del sistema')
+    ctx, pg = await nueva(br, 1280, 900, reduced_motion='reduce')
+    await ir_a_salas(pg, 1280)
+    await pg.wait_for_timeout(600)
+    sel = await pg.eval_on_selector('#r46RoomMotion', 'e => e.value')
+    nota = await pg.eval_on_selector('#r46MotionNote', 'e => (e.textContent||"").trim()')
+    anota('Con el sistema en movimiento reducido, la sala no arranca en normal',
+          sel in ('reducido', 'quieto'),
+          'el selector viene en "%s" ; nota: "%s"' % (sel, nota[:90]))
+    await ctx.close()
+
+
+# ------------------------------------------------ nombre accesible del lienzo
+async def c_lienzo(br):
+    print('\n[9f] El lienzo de la sala tiene alternativa textual')
+    ctx, pg = await nueva(br, 1280, 900)
+    await ir_a_salas(pg, 1280)
+    await pg.click('#r46RoomStart', timeout=60000)
+    await pg.wait_for_timeout(3000)
+    d = await pg.evaluate("""(()=>{
+      const c = document.querySelector('#r46RoomStage canvas');
+      if (!c) return null;
+      const st = document.getElementById('r46RoomStage');
+      return { rol: c.getAttribute('role'), etiqueta: c.getAttribute('aria-label'),
+               oculto: c.getAttribute('aria-hidden'),
+               textoStage: (st.innerText || '').trim().slice(0, 120),
+               estado: (document.getElementById('r46RoomStatus')||{}).textContent || '' };
+    })()""")
+    tiene = bool(d and (d['etiqueta'] or d['rol'] or d['oculto'] == 'true' or d['estado'].strip()))
+    anota('El lienzo no queda mudo para lectores de pantalla', tiene, json.dumps(d, ensure_ascii=False)[:240])
+    await ctx.close()
+
+
+async def main():
+    async with async_playwright() as p:
+        br = await p.chromium.launch(args=[
+            '--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader'])
+        for f in (c_reflujo, c_teclado, c_tactil, c_forced, c_prefiere_menos, c_lienzo):
+            try:
+                await f(br)
+            except Exception as e:
+                anota(f.__name__ + ' (la comprobacion misma reventó)', False,
+                      type(e).__name__ + ': ' + str(e)[:180])
+        await br.close()
+    json.dump(RES, open(OUT + '/a11y.json', 'w'), indent=2, ensure_ascii=False)
+    fallan = [r for r in RES if not r['ok']]
+    print('\n===== %d comprobaciones, %d fallan =====' % (len(RES), len(fallan)))
+    for r in fallan:
+        print('  FALLA: ' + r['check'] + ' :: ' + r['dato'])
+
+asyncio.run(main())
