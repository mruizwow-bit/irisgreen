    {
      "entity_id": "quiet-space:m-07:en",
      "content_id": "quiet-space:m-07",
      "fragment_id": "quiet-space:m-07:en:main",
      "locale": "en",
      "content_type": "quiet_space",
      "title": "Notice what is around you",
      "heading": "M-07",
      "text": "One step at a time. You can skip any step.\nHow would you like to do it?\nWith the senses\nOnly looking around you\nFind 5 things you can see.\nFind 4 things you can touch.\nFind 3 things you can hear.\nFind 2 things you can smell.\nFind 1 thing you can taste.\nFind 3 blue things.\nCount 5 corners.\nFind 2 round things.\nFind 1 written letter near you.\nNext\nSkip this one\nThat's all. You can stay here or leave.\nLeave",
      "canonical_url": "https://irisgreen.eu/en/quiet-space/",
      "source_type": "quiet_space_editorial_control",
