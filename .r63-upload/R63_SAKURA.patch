+import numpy as np
+# cuanto cielo queda a la vista: en la referencia de Maria la pared navy deja
+# alrededor de un tercio de fondo visible entre los racimos
+f=sys.argv[1]
+im=Image.open(f).convert('RGB')
+a=np.array(im).astype(float)
+# el cielo es lo mas azul-oscuro (navy) o lo mas azul-claro (light)
+lum=0.2126*a[:,:,0]+0.7152*a[:,:,1]+0.0722*a[:,:,2]
+azul=a[:,:,2]-a[:,:,0]
+cielo=(azul>18)&(lum<120) if 'navy' in f else (azul>8)
+print('%-34s cielo visible %.1f%%   lum %.0f'%(f.split('/')[-1],100*cielo.mean(),lum.mean()))
