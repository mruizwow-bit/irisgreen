  "freeze_rule": "Codex debe programar contra el SHA de PR #164 que publique esta adenda. Durante el siguiente ciclo no se cambiarán valores ni eventos salvo defecto de seguridad crítico documentado.",
  "canonical_public_shape": {
    "required": {
      "operation": "scalar",
      "dialogue": "scalar",
      "adaptation": "complete_object",
      "safety": "scalar",
      "visibility": "scalar",
      "speech": "scalar",
      "motion": "scalar",
      "language": "scalar",
      "revision": "integer"
    },
    "optional_metadata": {
      "speech_meta": "object",
      "motion_meta": "object"
    },
    "rule": "speech_meta, motion_meta o deriveSabikPresentation() pueden contener energía, límites o razón de finalización, pero nunca sustituyen speech o motion escalares."
  },
  "revision_policy": {
    "allowed_transition": "next.revision = previous.revision + 1",
    "rejected_transition": "revision y estado completos permanecen sin cambios"
  },
  "session_context_policy": "El contexto conversacional no vive dentro de la máquina S0. SUBMIT tras una aclaración conserva ese contexto en la capa de sesión/controlador; S0 no debe representarlo como reset ni como nueva sesión desligada.",
  "security_resolution_policy": {
    "submit_while_uncertain": "SUBMIT registra la respuesta a la aclaración pero mantiene safety=uncertain y operation=awaiting_clarification hasta un evento de resolución explícito.",
    "RISK_CONFIRMED": "Solo resolución explícita de riesgo hacia protección: safety=risk, dialogue=human_handoff, motion=protection_static.",
    "RISK_CLEARED": "Solo resolución explícita de una aclaración de seguridad desde safety=uncertain; vuelve a safety=normal y reanuda flujo ordinario controlado. No es reset genérico."
  },
  "speech_semantics": {
    "SPEECH_REQUEST": "La persona pulsa Escuchar: speech=starting, energía lógica 0, sin onda de voz.",
    "SPEECH_START": "Evento real speechSynthesis.onstart: speech=speaking y motion=voice_reactive, salvo movimiento reducido.",
    "SPEECH_BOUNDARY": "Actualiza una voz ya iniciada. Nunca convierte starting en speaking.",
    "SPEECH_PAUSE": "speech=paused y motion=off.",
    "SPEECH_RESUME": "speech=speaking y motion=voice_reactive, o off con movimiento reducido.",
    "SPEECH_STOP": "speech=ended y motion=ambient, o off con movimiento reducido.",
    "SPEECH_END": "speech=ended y motion=ambient, o off con movimiento reducido.",
    "SPEECH_ERROR": "speech=error y motion=off.",
    "safety_rule": "Con safety=risk o safety=human_handoff, la voz ordinaria no puede solicitarse ni iniciarse y motion permanece protection_static."
  },
