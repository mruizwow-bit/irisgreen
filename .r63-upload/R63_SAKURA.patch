+# -*- coding: utf-8 -*-
+"""
+R63 · SAKURA · comprobacion 9 de la orden
+teclado / tactil / foco / forced-colors / reflujo, y anchos 1440-390-320,
+sobre la pagina real y en los dos idiomas.
+"""
+import asyncio, json, os
+from playwright.async_api import async_playwright
+
+BASE = 'http://127.0.0.1:8732'
+OUT = '/home/claude/r63/qa/a11y'
+os.makedirs(OUT, exist_ok=True)
+RES = []
+
+
+def anota(nom, ok, dato):
+    RES.append({'check': nom, 'ok': bool(ok), 'dato': str(dato)})
+    print(('  PASA  ' if ok else '  FALLA ') + nom + '  ::  ' + str(dato))
+
+
+async def nueva(br, w, h, ruta='/es/sitio-tranquilo/', **kw):
+    ctx = await br.new_context(viewport={'width': w, 'height': h}, **kw)
+    pg = await ctx.new_page()
+    await pg.route('**://fonts.googleapis.com/**', lambda r: asyncio.ensure_future(r.abort()))
+    await pg.route('**://fonts.gstatic.com/**', lambda r: asyncio.ensure_future(r.abort()))
+    await pg.goto(BASE + ruta, wait_until='load')
+    return ctx, pg
+
+
+async def ir_a_salas(pg, w):
+    """A partir de cierto ancho las pestanas se sustituyen por un desplegable:
+    en estrecho hay que usar el select, no el boton."""
+    vis = await pg.locator('#r46-tab-room').is_visible()
+    if vis:
+        await pg.click('#r46-tab-room', timeout=60000)
+    else:
+        await pg.select_option('#r46ModeSelect', 'room')
+    await pg.wait_for_timeout(500)
+
+
+# ------------------------------------------------------------ reflujo
+async def c_reflujo(br):
+    print('\n[9a] Reflujo: sin barrido horizontal a 1440 / 390 / 320')
+    for w, h in ((1440, 900), (390, 760), (320, 640)):
+        ctx, pg = await nueva(br, w, h)
+        await ir_a_salas(pg, w)
+        await pg.wait_for_timeout(700)
+        d = await pg.evaluate("""(()=>({
+            doc: document.documentElement.scrollWidth,
+            vp: window.innerWidth,
+            culpables: [...document.querySelectorAll('body *')]
+              .filter(e => e.getBoundingClientRect().right > window.innerWidth + 1)
+              .slice(0,4).map(e => e.tagName.toLowerCase() + (e.id ? '#'+e.id : '') +
+                     (e.className && typeof e.className === 'string' ? '.'+e.className.trim().split(/\\s+/)[0] : ''))
+        }))()""")
+        ok = d['doc'] <= d['vp'] + 1
+        anota('%dpx sin barrido horizontal' % w, ok,
+              'scrollWidth %d vs ventana %d%s' % (d['doc'], d['vp'],
+              ('' if ok else ' ; se salen: ' + ', '.join(d['culpables']))))
+        await pg.screenshot(path='%s/reflujo_%d.png' % (OUT, w), full_page=False)
+        await ctx.close()
+
+
+# ------------------------------------------------------------ teclado
+async def c_teclado(br):
+    print('\n[9b] Teclado: recorrido completo y foco visible')
+    ctx, pg = await nueva(br, 1280, 900)
+    await ir_a_salas(pg, 1280)
+    await pg.wait_for_timeout(500)
+    # cuantos controles del panel de Salas son alcanzables tabulando
+    # se marca cada control con un indice propio: si se identifican por
+    # etiqueta+id, los cinco botones de sala comparten cadena y se cuentan
+    # como uno solo. Me paso, y daba un falso 6 de 11.
+    total = await pg.evaluate("""(()=>{
+      const p = document.getElementById('r46Rooms');
+      const l = [...p.querySelectorAll('button,select,input,a[href],[tabindex]:not([tabindex="-1"])')]
+        .filter(e => !e.disabled && e.offsetParent !== null);
+      l.forEach((e,i) => e.setAttribute('data-qa-i', String(i)));
+      return l.length;
+    })()""")
+    alcanzados = []
+    await pg.evaluate("document.getElementById('r46-tab-room').focus()")
+    for i in range(total * 3 + 12):
+        await pg.keyboard.press('Tab')
+        el = await pg.evaluate("(document.activeElement && document.activeElement.getAttribute('data-qa-i')) || null")
+        if el is not None and el not in alcanzados:
+            alcanzados.append(el)
+        if len(alcanzados) >= total:
+            break
+    anota('Todos los controles de Salas se alcanzan con Tab',
+          len(alcanzados) >= total, '%d alcanzados de %d visibles' % (len(alcanzados), total))
+
+    # foco visible: el anillo tiene que cambiar algo al enfocar
+    est = await pg.evaluate("""(()=>{
+      const b = document.getElementById('r46RoomStart');
+      b.blur(); const s0 = getComputedStyle(b);
+      const a0 = s0.outlineStyle + '|' + s0.outlineWidth + '|' + s0.boxShadow;
+      b.focus(); const s1 = getComputedStyle(b);
+      const a1 = s1.outlineStyle + '|' + s1.outlineWidth + '|' + s1.boxShadow;
+      return {sin: a0, con: a1};
+    })()""")
+    anota('El foco se ve en el boton de empezar', est['sin'] != est['con'],
+          'sin foco [%s] con foco [%s]' % (est['sin'][:60], est['con'][:60]))
+
+    # Escape sale de pantalla limpia
+    await pg.click('#r46Rooms [data-r46-clean]', timeout=60000)
+    await pg.wait_for_timeout(400)
+    limpio = await pg.evaluate("document.body.classList.contains('r46-clean')")
+    await pg.keyboard.press('Escape')
+    await pg.wait_for_timeout(400)
+    salido = await pg.evaluate("!document.body.classList.contains('r46-clean')")
+    anota('Pantalla limpia entra y Escape sale', limpio and salido,
+          'entra %s, sale con Escape %s' % (limpio, salido))
+
+    # idempotencia del modo limpio (fix heredado de PR #303)
+    # en modo limpio el propio boton queda oculto, que es lo correcto, asi que
+    # la idempotencia se prueba por la API, no pulsando un boton escondido
+    n = await pg.evaluate("""(()=>{
+      for (let i=0;i<4;i++) IGRincon46.enterClean();
+      const c = document.body.className.split(/\\s+/).filter(x=>x==='r46-clean').length;
+      IGRincon46.exitClean();
+      const tras = document.body.classList.contains('r46-clean');
+      return {clases:c, quedaTras:tras};
+    })()""")
+    anota('Modo limpio idempotente y reversible (heredado de PR #303)',
+          n['clases'] <= 1 and not n['quedaTras'],
+          'la clase r46-clean aparece %d vez tras 4 entradas; al salir queda: %s'
+          % (n['clases'], n['quedaTras']))
+    ocul = await pg.evaluate("""(()=>{
+      IGRincon46.enterClean();
+      const e = document.querySelector('#r46Rooms [data-r46-clean]');
+      const s = getComputedStyle(e);
+      const r = e.getBoundingClientRect();
+      IGRincon46.exitClean();
+      return {display:s.display, vis:s.visibility, alto:Math.round(r.height)};
+    })()""")
+    anota('En modo limpio lo oculto queda realmente oculto (heredado de PR #303)',
+          ocul['display'] == 'none' or ocul['vis'] == 'hidden' or ocul['alto'] == 0,
+          'display %s, visibility %s, alto %dpx' % (ocul['display'], ocul['vis'], ocul['alto']))
+    await ctx.close()
+
+
+# ------------------------------------------------- objetivos tactiles
+async def c_tactil(br):
+    print('\n[9c] Objetivos tactiles: minimo 24x24 CSS (WCAG 2.2 AA 2.5.8)')
+    ctx, pg = await nueva(br, 390, 760)
+    await ir_a_salas(pg, 390)
+    await pg.wait_for_timeout(600)
+    # el objetivo de un control con etiqueta es la etiqueta entera, no la caja
+    # del input: una casilla de 13 px dentro de un <label> grande cumple.
+    chicos = await pg.evaluate("""(()=>{
+      const p = document.getElementById('r46Rooms');
+      return [...p.querySelectorAll('button,select,input,a[href]')]
+        .filter(e => e.offsetParent !== null && !e.disabled)
+        .map(e => { const t = e.closest('label') || e;
+                    const r = t.getBoundingClientRect();
+                    return { q: e.tagName.toLowerCase()+(e.id?'#'+e.id:''),
+                             objetivo: (t === e ? 'el propio control' : 'su etiqueta'),
+                             w: Math.round(r.width), h: Math.round(r.height) }; })
+        .filter(o => o.w < 24 || o.h < 24);
+    })()""")
+    anota('Ningun control del panel baja de 24x24 en movil', len(chicos) == 0,
