    },
    "audience": {
      "type": "enum",
      "values": [
        "GENERAL",
        "AGE_0_12",
        "AGE_13_17",
        "AGE_18_PLUS",
        "ALL_AGES"
      ],
      "source": "Iris Green active audience profile",
      "persist": "session"
    },
    "language": {
      "type": "enum",
      "values": [
        "es",
        "en"
      ],
      "source": "active page language",
      "persist": "session"
    },
    "input_mode": {
      "type": "enum",
      "values": [
        "voice",
        "text"
      ],
      "persist": "turn"
    },
    "response_length": {
      "type": "enum",
      "values": [
        "minimum",
        "short",
        "normal",
        "detailed"
      ],
      "default": "normal",
      "persist": "session"
    },
    "last_intent": {
      "type": "string",
      "persist": "session"
    },
    "pending_slot": {
      "type": "string",
      "persist": "session"
    },
    "last_topic": {
      "type": "string",
      "persist": "session",
      "source": "dialogue_state"
    },
    "correction": {
      "type": "string",
      "persist": "turn",
      "source": "explicit_user_text"
    },
    "follow_up": {
      "type": "enum",
      "values": [
        "continue",
        "more",
        "new_topic",
        "finish"
      ],
      "persist": "turn",
      "source": "explicit_user_text"
    },
    "turn_count": {
      "type": "integer",
      "default": 0,
      "persist": "session",
      "source": "dialogue_runtime"
    },
    "fallback_count": {
      "type": "integer",
      "default": 0,
      "persist": "session",
      "source": "dialogue_runtime"
    },
    "last_prompt": {
      "type": "string",
      "persist": "session",
      "source": "dialogue_runtime"
    },
    "asr_error_count": {
      "type": "integer",
      "default": 0,
      "persist": "turn",
      "source": "voice_runtime"
    },
    "asr_confidence": {
      "type": "number",
      "persist": "turn",
      "source": "voice_runtime_if_available"
    },
    "capability": {
      "type": "string",
      "persist": "turn",
      "source": "capability_router"
    },
    "compare_topic": {
      "type": "dynamic_entity",
      "persist": "turn",
      "source": "user_text"
    },
    "timezone": {
      "type": "string",
      "persist": "session",
      "source": "runtime_or_explicit_user_context",
      "privacy": "no_precise_location_inference"
    },
    "location": {
      "type": "string",
      "persist": "turn",
      "source": "explicit_user_or_permissioned_tool_only",
      "privacy": "never_profile_by_default"
    },
    "safety_flags": {
      "type": "array",
      "default": [],
      "persist": "session",
      "source": "safety_gate_only"
    }
  },
  "rendering": {
    "placeholder_syntax": "{slot}",
    "unknown_slot_policy": "fail_closed",
    "prompt_selection": "session_cycle",
    "source_text_never_used_as_prompt": true
  },
  "forbidden_passive_variables": {
    "user_emotion": "Do not infer emotion from voice, face, typing cadence, pauses or other passive signals.",
    "personalization_profile": "Do not create a hidden long-term profile from conversation content by default.",
    "precise_location_history": "Do not persist precise location history.",
    "raw_transcript_history": "Do not persist voice transcripts by default."
  },
  "session_policy": {
    "memory": "session_only_by_default",
    "audio_persistence": false,
    "transcript_persistence": false,
    "precise_location_persistence": false,
    "passive_emotion_inference": false
  }
}