{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irisgreen.eu/schemas/sabik/i0/layered-case-v0.4.json",
  "title": "Sabik I0 v0.4 layered development/calibration case",
  "type": "object",
  "required": [
    "id",
    "dataset_role",
    "locale",
    "utterance",
    "context",
    "expected_gate",
    "expected_commands",
    "expected_result_kind",
    "expected_actions",
    "expected_s0_events",
    "should_execute",
    "expected_b3",
    "ambiguity",
    "tags",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^I0-(DEV|CAL)-[0-9]{4}$"
    },
    "dataset_role": {
      "enum": [
        "development",
        "calibration"
      ]
    },
    "locale": {
      "enum": [
        "es",
        "en"
      ]
    },
    "utterance": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object"
    },
    "expected_gate": {
      "enum": [
        "normal",
        "uncertain",
        "confirmed",
        "cleared",
        "handoff"
      ]
    },
    "expected_commands": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "expected_result_kind": {
      "enum": [
        "response",
        "action_result",
        "clarification",
        "insufficient",
        "human_help",
        "out_of_scope"
      ]
    },
    "expected_actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "expected_s0_events": {
      "type": "array",
      "items": {
        "enum": [
          "RISK_UNCERTAIN",
          "RISK_CONFIRMED",
          "RISK_CLEARED",
          "HUMAN_HANDOFF",
          "PAUSE_ASSISTANT",
          "SPEECH_STOP",
          "ASK_CLARIFICATION"
        ]
      }
    },
    "should_execute": {
      "type": "boolean"
    },
    "expected_b3": {
      "enum": [
        "PRESENTE",
        "ORIENTAR",
        "TRANSICIÓN",
        "PAUSA",
        "CONFIRMAR"
      ]
    },
    "ambiguity": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "confidence_expectation": {
      "type": "object",
      "properties": {
        "policy_target": {
          "type": "string"
        },
        "risk_class": {
          "enum": [
            "local_reversible",
            "local_with_loss",
            "none"
          ]
        },
        "expected_band": {
          "enum": [
            "very_high",
            "high",
            "medium",
            "low"
          ]
        },
        "margin": {
          "enum": [
            "wide",
            "narrow"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "intent",
        "parameters"
      ],
      "properties": {
        "intent": {
          "enum": [
            "ENCONTRAR_CONTENIDO",
            "ABRIR_CONTENIDO",
            "CAMBIAR_TAMANO_TEXTO",
            "CAMBIAR_MOVIMIENTO",
            "CAMBIAR_PASO_A_PASO",
            "CAMBIAR_VISTA_SENCILLA",
            "CAMBIAR_DETALLES",
            "SIGUIENTE",
            "ATRAS",
            "REPETIR_INDICACION",
            "RESTABLECER_PREFERENCIAS",
            "CONFIRMAR_ACCION",
            "CANCELAR",
            "DESHACER_ULTIMA_ACCION",
            "RECHAZAR_RESULTADO",
            "OTRA_VIA",
            "DETENER",
            "PEDIR_AYUDA_HUMANA"
          ]
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "type",
        "parameters",
        "risk"
      ],
      "properties": {
        "type": {
          "enum": [
            "SET_TEXT_SIZE",
            "SET_MOTION",
            "SET_STEP_BY_STEP",
            "SET_SIMPLE_VIEW",
            "SET_DETAILS",
            "STEP_NEXT",
            "STEP_BACK",
            "REPEAT_INSTRUCTION",
            "NAVIGATE_IRIS",
            "RESET_PREFERENCES",
            "RESTORE_PREVIOUS_STATE"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "risk": {
          "enum": [
            "local_reversible",
            "local_with_loss",
            "external_effect"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
