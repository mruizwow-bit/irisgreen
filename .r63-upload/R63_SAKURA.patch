+# -*- coding: utf-8 -*-
+"""
+R63 · SAKURA · EVIDENCIA TEMPORAL R2 · captura por secuencia determinista
+
+POR QUE ASI, y no grabando la pantalla.
+
+En este contenedor no se puede grabar el lienzo vivo. Lo comprobé de cuatro
+maneras y las cuatro fallan o no sirven:
+
+  1. capturas de Playwright sobre el lienzo vivo -> fotogramas cacheados;
+     entre el instante 10 y el 200 de la escena salian identicas byte a byte.
+  2. grabacion de video de Playwright -> 27,1 s de video congelado,
+     diferencia maxima entre fotogramas: 2.
+  3. canvas.captureStream + MediaRecorder -> la pista queda "live" pero el
+     grabador entrega 0 bytes.
+  4. lectura directa: gl.readPixels del lienzo cuesta 7,6 s por llamada con la
+     sala animando. El cuello es la sincronizacion del rasterizador por
+     software, no el dibujo: la sala renderiza a 16,7 ms por fotograma.
+
+Lo que si funciona: parar el bucle y pedirle a la sala un instante concreto.
+`IGRincon46.freeze(t)` dibuja la escena en el tiempo t. El stage deriva el paso
+de tiempo de la diferencia con el t anterior y lo multiplica por la deriva del
+nivel de movimiento, asi que avanzar t de 1/15 en 1/15 produce:
+
+  NORMAL    la escena avanza 1/15 s por fotograma  -> tiempo real
+  REDUCIDO  el reloj interno avanza 0,22 de eso    -> mas lento, como debe
+  QUIETO    no avanza
+
+Es un render determinista, no una grabacion de pantalla. Son fotogramas reales
+de la sala real en instantes reales y equiespaciados; lo unico que no reproduce
+es el jitter de fotograma de un equipo concreto, que es justo lo que queda
+pendiente de QA en hardware.
+
+Uso:  python3 secuencia.py <nivel> <desde> <hasta>
+      python3 secuencia.py montar
+"""
+import asyncio, base64, glob, json, os, subprocess, sys
+import numpy as np
+from PIL import Image
+from playwright.async_api import async_playwright
+
+BASE = 'http://127.0.0.1:8732'
+OUT = '/home/claude/r63/qa/evidencia'
+FPS = 15
+SEG = 20
+N = FPS * SEG          # 300 fotogramas
+T0 = 12.0              # instante de partida de la escena
+
+PARCHE = """
+(function () {
+  var o = HTMLCanvasElement.prototype.getContext;
+  HTMLCanvasElement.prototype.getContext = function (t, opts) {
+    if (t === 'webgl2' || t === 'webgl') {
+      opts = Object.assign({}, opts || {}, { preserveDrawingBuffer: true });
+    }
+    return o.call(this, t, opts);
+  };
+})();
+"""
+
+
+async def capturar(nivel, desde, hasta):
+    d = os.path.join(OUT, 'seq_' + nivel)
+    os.makedirs(d, exist_ok=True)
+    async with async_playwright() as p:
+        br = await p.chromium.launch(args=[
+            '--use-gl=angle', '--use-angle=swiftshader', '--enable-unsafe-swiftshader'])
+        pg = await br.new_page(viewport={'width': 900, 'height': 560})
+        await pg.add_init_script(PARCHE)
+        await pg.route('**://fonts.googleapis.com/**', lambda r: asyncio.ensure_future(r.abort()))
+        await pg.route('**://fonts.gstatic.com/**', lambda r: asyncio.ensure_future(r.abort()))
+        await pg.goto(BASE + '/es/sitio-tranquilo/', wait_until='load')
+        await pg.click('#r46-tab-room', timeout=90000)
+        await pg.click('button[data-r46-room="sakura"]', timeout=90000)
+        await pg.select_option('#r46RoomMotion', nivel)
+        await pg.click('#r46RoomStart', timeout=90000)
+        await pg.wait_for_timeout(3500)
+
+        # rebobinado: se redibujan los instantes anteriores sin capturarlos, para
+        # que el reloj de material de la sala llegue al mismo sitio que llegaria
+        # de un tiron. Sin esto, cada tanda empezaria la escena de cero y se
+        # veria el corte.
+        if desde > 0:
+            await pg.evaluate("""(a) => { for (var i = 0; i < a.n; i++)
+                IGRincon46.freeze(a.t0 + i / a.fps, 0.7); }""",
+                              {'n': desde, 't0': T0, 'fps': FPS})
+
+        for i in range(desde, hasta):
+            await pg.evaluate('IGRincon46.freeze(%.6f, 0.7)' % (T0 + i / FPS))
+            u = await pg.evaluate(
+                "document.querySelector('#r46RoomStage canvas').toDataURL('image/jpeg',0.82)")
+            with open('%s/%04d.jpg' % (d, i), 'wb') as f:
+                f.write(base64.b64decode(u.split(',', 1)[1]))
+        inf = await pg.evaluate("JSON.stringify(IGRincon46.engines().rooms)")
+        await br.close()
+    hechos = len(glob.glob(d + '/*.jpg'))
+    print('%s: capturados %d..%d, total en disco %d de %d  %s'
+          % (nivel, desde, hasta - 1, hechos, N, inf))
+
+
+def montar():
+    res = {}
+    for nivel in ('normal', 'reducido', 'quieto'):
+        d = os.path.join(OUT, 'seq_' + nivel)
+        fs = sorted(glob.glob(d + '/*.jpg'))
+        if not fs:
+            print('%s: sin fotogramas' % nivel); continue
+        mp4 = '%s/sakura_%s.mp4' % (OUT, nivel)
+        subprocess.run(['ffmpeg', '-y', '-loglevel', 'error', '-framerate', str(FPS),
+                        '-pattern_type', 'glob', '-i', d + '/*.jpg',
+                        '-c:v', 'libx264', '-preset', 'slow', '-crf', '24',
+                        # el lienzo mide 780x347 y libx264 exige altura par
+                        '-vf', 'scale=trunc(iw/2)*2:trunc(ih/2)*2',
+                        '-pix_fmt', 'yuv420p', mp4], check=True)
+        dur = float(subprocess.check_output(
+            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
+             '-of', 'csv=p=0', mp4], text=True).strip())
+        ims = [np.array(Image.open(f).convert('L').resize((360, 200))).astype(np.float32)
+               for f in fs[::max(1, len(fs) // 60)]]
+        pix = [float((np.abs(ims[i + 1] - ims[i]) > 6).mean() * 100) for i in range(len(ims) - 1)]
+        mx = [float(np.abs(ims[i + 1] - ims[i]).max()) for i in range(len(ims) - 1)]
+        res[nivel] = {'mp4': os.path.basename(mp4), 'duracion': round(dur, 2),
+                      'fotogramas': len(fs), 'fps': FPS,
+                      'pix6': round(float(np.mean(pix)), 4) if pix else 0.0,
+                      'max': round(float(np.mean(mx)), 1) if mx else 0.0,
+                      'recorrido': round(float(np.abs(ims[-1] - ims[0]).mean()), 3)}
+        print('%-9s %5.1f s  %3d fotogramas  pix>6 %.3f%%  max %.0f  recorrido %.2f'
+              % (nivel, dur, len(fs), res[nivel]['pix6'], res[nivel]['max'], res[nivel]['recorrido']))
+    n, r, q = res.get('normal'), res.get('reducido'), res.get('quieto')
+    ch = []
+    if n and r and q:
+        ch = [
+            ('NORMAL dura lo contratado (15-30 s)', 15 <= n['duracion'] <= 30, '%.1f s' % n['duracion']),
+            ('REDUCIDO dura lo contratado (15-30 s)', 15 <= r['duracion'] <= 30, '%.1f s' % r['duracion']),
+            ('NORMAL se mueve', n['pix6'] > 0.5, '%.3f%% de pixeles entre fotogramas' % n['pix6']),
+            ('REDUCIDO se mueve menos que NORMAL', r['pix6'] < n['pix6'],
+             '%.3f%% frente a %.3f%%' % (r['pix6'], n['pix6'])),
+            ('SIN_MOVIMIENTO congelado', q['pix6'] < 0.02 and q['max'] < 3,
+             '%.4f%%, maxima %.0f' % (q['pix6'], q['max'])),
+        ]
+        print()
+        for t, ok, dato in ch:
+            print(('  PASA  ' if ok else '  FALLA ') + t + '  ::  ' + dato)
+    json.dump({'metodo': 'render determinista por freeze; ver cabecera de secuencia.py',
+               'fps': FPS, 'segundos': SEG, 'niveles': res,
+               'checks': [{'check': t, 'ok': bool(o), 'dato': d} for t, o, d in ch]},
+              open(OUT + '/evidencia_r2.json', 'w'), indent=2, ensure_ascii=False)
+
+
+if __name__ == '__main__':
+    if sys.argv[1] == 'montar':
+        montar()
+    else:
+        asyncio.run(capturar(sys.argv[1], int(sys.argv[2]), int(sys.argv[3])))
