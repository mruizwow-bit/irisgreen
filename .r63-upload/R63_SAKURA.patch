+    ' w *= 1.0 - 0.30 * smoothstep(0.45, 1.0, y);',
+    ' float d = abs(vLocal.x) / max(w, 0.02);',
+    ' float aa = max(fwidth(d), 0.03) + vDif * 0.85;',
+    ' float cov = (1.0 - smoothstep(1.0 - aa, 1.0 + aa, d)) * (1.0 - smoothstep(0.94 - vDif * 0.5, 1.0, abs(y)));',
