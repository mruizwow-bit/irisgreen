# Desarrollo activo: los assets compartidos se revalidan en cada carga para evitar mezclar versiones.
/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate
/sitemap-1.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
