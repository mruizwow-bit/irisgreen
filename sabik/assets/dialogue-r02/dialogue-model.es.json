      "capability": "weather"
    },
    {
      "id": "utility.calculate",
      "priority": 91,
      "patterns": [
        "^(?:calcula|cuanto es|cuánto es)\\s+(?<expression>.+)$"
      ],
      "action": "route",
      "capability": "calculator"
    },
    {
      "id": "general.question",
      "priority": 10,
      "patterns": [
