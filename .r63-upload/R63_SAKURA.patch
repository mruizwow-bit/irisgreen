+# -*- coding: utf-8 -*-
+"""
+IRIS GREEN . R63 . SAKURA . CONSTRUCCION DE LOS DOS MASTERS
+
+Los dos climas comparten SEMILLA: misma ramificacion, mismos racimos, misma
+composicion. Lo unico que cambia es la paleta. No son dos disenos distintos,
+son la misma instalacion bajo dos climas, que es lo que pide la orden.
+"""
+import math, random, sys, os
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from PIL import Image, ImageDraw, ImageFilter
+from dosel import PAL, Capa, sprite_flor, sprite_capullo, mezcla
+
+SS = 2
+PARED_W, PARED_H = 2048, 768
+OCULO_L = 1024
+
+def rapido():
+    """Modo de tanteo: misma composicion a un cuarto de resolucion. Sirve para
+    ajustar densidad y cobertura sin pagar 2m40 por vuelta."""
+    global SS, PARED_W, PARED_H, OCULO_L
+    SS, PARED_W, PARED_H, OCULO_L = 1, 1024, 384, 512
+
+K_DENS = 2.9      # fijado por barrido contra la cobertura de la referencia
+SEM_PARED = 20260929
+SEM_OCULO = 77310
+
+
+# ------------------------------------------------------------------ rama
+def rama(capa, x, y, ang, largo, grosor, gen, rnd, cfg, puntos):
+    """Un tramo curvo que se afina, y al final bifurca. El afinado y la
+    bifurcacion son lo que distingue una rama de un trazo."""
+    pasos = max(2, int(largo / cfg['paso']))
+    dl = largo / pasos
+    curva = rnd.uniform(-0.05, 0.05) + cfg['grav'] * rnd.uniform(0.4, 1.2)
+    px, py = x, y
+    for i in range(pasos):
+        ang += curva + rnd.uniform(-0.055, 0.055)
+        nx = px + math.cos(ang) * dl
+        ny = py + math.sin(ang) * dl
+        g = grosor * (1.0 - 0.30 * (i + 1) / pasos)
+        capa.linea((px, py), (nx, ny), g)
+        if gen >= cfg['genFlor']:
+            puntos.append((nx, ny, gen))
+        px, py = nx, ny
+    if gen >= cfg['maxGen'] or grosor < cfg['minGrosor']:
+        return
+    n = 2 if rnd.random() < 0.76 else 3
+    for k in range(n):
+        da = rnd.uniform(0.24, 0.66) * (1 if k % 2 == 0 else -1)
+        if n == 3 and k == 2:
+            da = rnd.uniform(-0.20, 0.20)
+        rama(capa, px, py, ang + da,
+             largo * rnd.uniform(0.58, 0.80),
+             grosor * rnd.uniform(0.52, 0.70),
+             gen + 1, rnd, cfg, puntos)
+
+
+def florear(capa, puntos, sprites, rnd, cfg):
+    """Racimos colgando de las ultimas generaciones. Repartir flores sueltas
+    por toda la superficie es justo lo que leia como confeti."""
+    rnd.shuffle(puntos)
+    n = int(len(puntos) * cfg['densFlor'])
+    for (x, y, gen) in puntos[:n]:
+        m = rnd.randint(cfg['racMin'], cfg['racMax'])
+        rad = cfg['racR'] * rnd.uniform(0.65, 1.35)
+        for j in range(m):
+            a = rnd.uniform(0, math.tau)
+            d = rad * math.sqrt(rnd.random())
+            fx = x + math.cos(a) * d
+            fy = y + math.sin(a) * d + cfg['caida'] * rnd.random()
+            s = cfg['tam'] * rnd.uniform(0.58, 1.34)
+            i = min(len(sprites) - 1, int(len(sprites) * rnd.random() ** 1.9))
+            capa.flor(sprites[i], fx, fy, s, rnd.uniform(0, 360))
+
+
+def sprites_de(pal, esc, sem):
+    col = pal['flor']
+    out = []
+    for i, c in enumerate(col):
+        out.append(sprite_flor(c, pal['centro'], max(24, int(150 * esc)), sem + i))
+    for i in range(2):
+        out.append(sprite_capullo(col[i], max(18, int(110 * esc)), sem + 40 + i))
+    return out
+
+
+def cielo_pared(pal, w, h):
+    base = Image.new('RGB', (w, h))
+    d = ImageDraw.Draw(base)
+    c = pal['cielo']
+    for y in range(h):
+        t = y / max(1, h - 1)
+        if t < 0.5:
+            col = mezcla(c[0], c[1], t / 0.5)
+        else:
+            col = mezcla(c[1], c[2], (t - 0.5) / 0.5)
+        d.line([(0, y), (w, y)], fill=col)
+    return base
+
+
+def cielo_oculo(pal, L):
+    """En el oculo el cielo se abre en el centro: es lo que da respiracion."""
+    base = Image.new('RGB', (L, L))
+    px = base.load()
+    c = pal['cielo']
+    cx = cy = L / 2.0
+    for y in range(L):
+        for x in range(0, L, 2):
+            r = math.hypot(x - cx, y - cy) / (L * 0.5)
+            t = min(1.0, r)
+            col = mezcla(c[2], c[0], t ** 0.85)
+            px[x, y] = col
+            if x + 1 < L:
+                px[x + 1, y] = col
+    return base
+
+
+def componer(cielo, capas, pal, w, h):
+    """Cielo al fondo y los planos encima, de lejos a cerca. El plano lejano se
+    lava hacia el cielo y se desenfoca: es lo que da profundidad de verdad."""
+    out = cielo.copy()
+    for (capa, lavado, desenf) in capas:
+        rgb = capa.rgb
+        a = capa.a
+        if lavado > 0.001:
+            rgb = Image.blend(rgb, cielo, lavado)
+        if desenf > 0.01:
+            rgb = rgb.filter(ImageFilter.GaussianBlur(desenf))
+            a = a.filter(ImageFilter.GaussianBlur(desenf))
+        out.paste(rgb, (0, 0), a)
+    return out
+
+
+# ----------------------------------------------------------------- pared
+def render_pared(clima):
+    pal = PAL[clima]
+    W, H = PARED_W * SS, PARED_H * SS
+    cielo = cielo_pared(pal, W, H)
+    planos = [
+        # esc  troncos  grosor  largo  tam    dens  lavado desenf
+        (0.52, 11, 5.0, 165, 30, 0.016, pal['lejos'], 2.6 * SS),
+        (0.80, 8, 8.5, 230, 46, 0.014, pal['lejos'] * 0.42, 0.8 * SS),
+        (1.18, 6, 13.5, 300, 70, 0.012, 0.0, 0.0),
+    ]
+    capas = []
+    for idx, (esc, ntr, gr, lg, tam, dens, lav, des) in enumerate(planos):
+        rnd = random.Random(SEM_PARED + idx * 1009)
+        capa = Capa(W, H, periodo=W)
+        cfg = {'paso': 12 * SS, 'grav': 0.055, 'genFlor': 2, 'maxGen': 5,
+               'minGrosor': 0.8 * SS, 'densFlor': dens * K_DENS, 'racMin': 3, 'racMax': 7,
+               'racR': tam * SS * 1.05, 'caida': 10 * SS * esc, 'tam': tam * SS}
+        puntos = []
+        # troncos que entran por arriba: el dosel cuelga sobre quien mira
+        for i in range(ntr):
+            x = (i + rnd.uniform(0.12, 0.88)) * W / ntr
+            rama(capa, x, -30 * SS, math.pi * rnd.uniform(0.30, 0.70),
+                 lg * SS * rnd.uniform(0.85, 1.20), gr * SS, 0, rnd, cfg, puntos)
+        # y algunos por abajo, para que el dosel no se corte a media pared
+        for i in range(max(3, ntr // 2)):
+            x = (i + rnd.uniform(0.1, 0.9)) * W / max(3, ntr // 2)
+            rama(capa, x, H + 24 * SS, -math.pi * rnd.uniform(0.28, 0.72),
+                 lg * SS * rnd.uniform(0.55, 0.85), gr * SS * 0.7, 1, rnd, cfg, puntos)
+        # y algunos que entran por los lados, para que haya diagonales
+        for i in range(max(2, ntr // 3)):
+            y = rnd.uniform(0.15, 0.85) * H
+            izq = rnd.random() < 0.5
+            rama(capa, -20 * SS if izq else W + 20 * SS, y,
+                 rnd.uniform(-0.45, 0.45) if izq else math.pi + rnd.uniform(-0.45, 0.45),
+                 lg * SS * rnd.uniform(0.7, 1.0), gr * SS * 0.8, 1, rnd, cfg, puntos)
+        capa.cerrar_ramas(pal['rama'], pal['ramaA'])
+        florear(capa, puntos, sprites_de(pal, esc, SEM_PARED + idx * 31), rnd, cfg)
+        capas.append((capa, lav, des))
+    img = componer(cielo, capas, pal, W, H)
+    return img.resize((PARED_W, PARED_H), Image.LANCZOS)
+
+
+# ----------------------------------------------------------------- oculo
+def render_oculo(clima):
+    pal = PAL[clima]
+    L = OCULO_L * SS
+    cielo = cielo_oculo(pal, L)
+    planos = [
+        (0.55, 11, 5.5, 150, 32, 0.014, pal['lejos'], 2.4 * SS),
+        (0.85, 8, 9.0, 200, 50, 0.012, pal['lejos'] * 0.40, 0.7 * SS),
+        (1.20, 5, 14.0, 260, 74, 0.010, 0.0, 0.0),
+    ]
+    capas = []
+    cx = cy = L / 2.0
+    for idx, (esc, ntr, gr, lg, tam, dens, lav, des) in enumerate(planos):
+        rnd = random.Random(SEM_OCULO + idx * 1009)
+        capa = Capa(L, L)
+        cfg = {'paso': 12 * SS, 'grav': 0.0, 'genFlor': 1, 'maxGen': 5,
+               'minGrosor': 0.8 * SS, 'densFlor': dens * K_DENS, 'racMin': 3, 'racMax': 7,
+               'racR': tam * SS * 1.05, 'caida': 0.0, 'tam': tam * SS}
+        puntos = []
+        # las ramas entran del borde hacia dentro y se paran antes del centro:
+        # el hueco central es la respiracion visual que pide la orden
+        for i in range(ntr):
+            a = (i + rnd.uniform(0.15, 0.85)) * math.tau / ntr
+            r0 = L * 0.56
+            x = cx + math.cos(a) * r0
+            y = cy + math.sin(a) * r0
+            hacia = math.atan2(cy - y, cx - x) + rnd.uniform(-0.55, 0.55)
+            rama(capa, x, y, hacia, lg * SS * rnd.uniform(0.80, 1.15), gr * SS,
+                 0, rnd, cfg, puntos)
+        capa.cerrar_ramas(pal['rama'], pal['ramaA'])
+        # los puntos muy centrales se descartan: el centro queda abierto
+        puntos = [p for p in puntos
+                  if math.hypot(p[0] - cx, p[1] - cy) > L * 0.17 * rnd.uniform(0.7, 1.3)]
+        florear(capa, puntos, sprites_de(pal, esc, SEM_OCULO + idx * 31), rnd, cfg)
+        capas.append((capa, lav, des))
+    img = componer(cielo, capas, pal, L, L)
+    return img.resize((OCULO_L, OCULO_L), Image.LANCZOS)
+
+
+if __name__ == '__main__':
+    if '--rapido' in sys.argv:
+        rapido()
+    for arg in sys.argv:
+        if arg.startswith('--dens='):
+            K_DENS = float(arg.split('=')[1])
+            globals()['K_DENS'] = K_DENS
+    destino = sys.argv[1] if len(sys.argv) > 1 else '/home/claude/r63/out'
+    os.makedirs(destino, exist_ok=True)
+    climas = ('navy',) if '--solo-navy' in sys.argv else ('navy', 'light')
+    for clima in climas:
+        p = render_pared(clima)
+        p.save(os.path.join(destino, 'pared_%s.png' % clima))
+        print('pared', clima, p.size)
+        o = render_oculo(clima)
+        o.save(os.path.join(destino, 'oculo_%s.png' % clima))
+        print('oculo', clima, o.size)
