diff --git a/assets/ig-global-ui-tokens-2026.css b/assets/ig-global-ui-tokens-2026.css
new file mode 100644
index 00000000..a053f487
--- /dev/null
+++ b/assets/ig-global-ui-tokens-2026.css
@@ -0,0 +1,48 @@
+/* IRIS_GREEN_GLOBAL_UI_TOKENS_2026_ADOPTED · canonical semantic UI palette. */
+:root,
+html[data-ig-theme="dark"]{
+  --ig-bg-page:#0B1A2B;
+  --ig-bg-surface:#15304A;
+  --ig-bg-surface-soft:#1D3D5C;
+  --ig-text:#EEF4F8;
+  --ig-text-muted:#C9D5DD;
+  --ig-button-primary-bg:#DCE8F2;
+  --ig-button-primary-fg:#0B1A2B;
+  --ig-button-secondary-bg:#15304A;
+  --ig-button-secondary-fg:#EEF4F8;
+  --ig-link:#9FDCEA;
+  --ig-accent:#C3B8FF;
+  --ig-accent-secondary:#9FDCEA;
+  --ig-border-control:#8494A8;
+  --ig-separator:#2A4460;
+  --ig-focus:#C3B8FF;
+  --ig-error:#FFB3C1;
+  --ig-success:#9BE0B4;
+}
+html[data-ig-theme="light"]{
+  --ig-bg-page:#F6F8FB;
+  --ig-bg-surface:#F4F7FA;
+  --ig-bg-surface-soft:#EEF2F6;
+  --ig-text:#17395C;
+  --ig-text-muted:#435268;
+  --ig-button-primary-bg:#17395C;
+  --ig-button-primary-fg:#EEF4F8;
+  --ig-button-secondary-bg:#E6F1F8;
+  --ig-button-secondary-fg:#17395C;
+  --ig-link:#1F5F8B;
+  --ig-accent:#5A49A8;
+  --ig-accent-secondary:#197991;
+  --ig-border-control:#7A869D;
+  --ig-separator:#D5E1EC;
+  --ig-focus:#5A49A8;
+  --ig-error:#8A2942;
+  --ig-success:#1D6B3A;
+}
+/* Transitional aliases: one palette source, no parallel product palettes. */
+:root{
+  --ig-surface-content:var(--ig-bg-surface);
+  --ig-surface-soft:var(--ig-bg-surface-soft);
+  --ig-ink:var(--ig-text);
+  --ig-ink-muted:var(--ig-text-muted);
+  --ig-control-border:var(--ig-border-control);
+}
diff --git a/assets/rincon-r46-breath.js b/assets/rincon-r46-breath.js
