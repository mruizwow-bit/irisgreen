{
  "schema": "iris-green/sabik-dialogue-variables/v1",
  "slots": {
    "topic": {
      "type": "dynamic_entity",
      "description": "Tema principal de la conversación.",
      "source": "Iris Green public search titles, aliases and active session context",
      "examples": [
        "autismo",
        "TOC",
        "ansiedad",
        "sueño",
        "TDAH"
      ],
      "persist": "session"
    },
    "aspect": {
      "type": "enum",
      "description": "Parte del tema que la persona quiere consultar.",
      "persist": "session",
      "values": {
        "definition": {
          "es": [
            "qué es",
            "definición",
            "significado",
            "explicación"
          ],
          "en": [
            "what is",
            "definition",
            "meaning",
            "explanation"
          ],
          "search_terms": {
            "es": [
              "qué es"
            ],
            "en": [
              "what is"
            ]
          }
        },
        "signals": {
          "es": [
            "señales",
            "senales",
            "síntomas",
            "sintomas",
            "rasgos",
            "cómo se nota",
            "como se nota"
          ],
          "en": [
            "signs",
            "symptoms",
            "traits",
            "how it shows up"
          ],
          "search_terms": {
            "es": [
              "señales"
            ],
            "en": [
              "signs"
            ]
          }
        },
        "supports": {
          "es": [
            "apoyos",
            "ayudas",
            "qué ayuda",
            "que ayuda",
            "adaptaciones"
          ],
          "en": [
            "supports",
            "support",
            "what helps",
            "accommodations"
          ],
          "search_terms": {
            "es": [
              "apoyos"
            ],
            "en": [
              "supports"
            ]
          }
        },
        "assessment": {
          "es": [
            "valoración",
            "valoracion",
            "evaluación",
            "evaluacion",
            "diagnóstico",
            "diagnostico",
            "cómo se valora",
            "como se valora"
          ],
          "en": [
            "assessment",
            "evaluation",
            "diagnosis",
            "how it is assessed"
          ],
          "search_terms": {
            "es": [
              "valoración"
            ],
            "en": [
              "assessment"
            ]
          }
        },
        "causes": {
          "es": [
            "causas",
            "por qué ocurre",
            "por que ocurre",
            "origen"
          ],
          "en": [
            "causes",
            "why it happens",
            "origin"
          ],
          "search_terms": {
            "es": [
              "causas"
            ],
            "en": [
              "causes"
            ]
          }
        },
        "sensory": {
          "es": [
            "sensorial",
            "sentidos",
            "ruido",
            "luz",
            "texturas"
          ],
          "en": [
            "sensory",
            "senses",
            "noise",
            "light",
            "textures"
          ],
          "search_terms": {
            "es": [
              "sensorial"
            ],
            "en": [
              "sensory"
            ]
          }
        },
        "communication": {
          "es": [
            "comunicación",
            "comunicacion",
            "habla",
            "lenguaje",
            "interacción",
            "interaccion"
          ],
          "en": [
            "communication",
            "speech",
            "language",
            "interaction"
          ],
          "search_terms": {
            "es": [
              "comunicación"
            ],
            "en": [
              "communication"
            ]
          }
        },
        "daily_life": {
          "es": [
            "vida diaria",
            "día a día",
            "dia a dia",
            "rutinas"
          ],
          "en": [
            "daily life",
            "everyday life",
            "routines"
          ],
          "search_terms": {
            "es": [
              "vida diaria"
            ],
            "en": [
              "daily life"
            ]
          }
        },
        "education_work": {
          "es": [
            "colegio",
            "escuela",
            "clase",
            "estudios",
            "trabajo"
          ],
          "en": [
            "school",
            "class",
            "education",
            "work"
          ],
          "search_terms": {
            "es": [
              "estudios trabajo"
            ],
            "en": [
              "education work"
            ]
          }
        },
        "research": {
          "es": [
            "investigación",
            "investigacion",
            "estudios",
            "evidencia"
          ],
          "en": [
            "research",
            "studies",
            "evidence"
          ],
          "search_terms": {
            "es": [
              "investigación"
            ],
            "en": [
              "research"
            ]
          }
        }
