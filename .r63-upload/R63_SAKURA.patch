@@ -0,0 +1,74 @@
+<!doctype html><meta charset="utf-8">
+<style>html,body{margin:0;background:#c9bfc6}canvas{display:block}</style>
+<canvas id="c" width="1400" height="420"></canvas>
+<script>
+/* Banco de siluetas: dibuja SOLO el contorno de cada familia de forma, grande y
+   sobre fondo plano, para poder juzgar la geometria sin que el material, la luz
+   ni la sala distraigan. */
+var c=document.getElementById('c'), g=c.getContext('2d');
+function smax(a,b,k){var h=Math.max(k-Math.abs(a-b),0)/k;return Math.max(a,b)+h*h*k*0.25;}
+/* Perfil por ANCHO segun la altura. En polares no se puede afinar una gota sin
+   acortarla, y de ahi salia el pico. Aqui el ancho es una funcion de y, que es
+   como se describe de verdad un cuerpo inflado. */
+function perfil(y, kind, f){
+  var soft = 1.0 - f[2];
+  var w = Math.sqrt(Math.max(0, 1 - y*y));       /* circulo de partida */
+  /* peso: la masa baja del ecuador, asi que ensancha un poco por debajo */
+  w *= 1.0 + soft*0.16*smooth(0.25,-0.55,y);
+  /* tension: el muy inflado se redondea arriba */
+  w *= 1.0 + (1.0-soft)*0.05*smooth(0.0,0.9,y);
+  if(kind===1){
+    /* colgante: el hombro se mantiene ancho y a partir del ecuador la tela se
+       junta despacio hasta un cuello fino, sin punta */
+    var g = smooth(0.30,-0.98,y);
+    w *= 1.0 - f[0]*1.30*Math.pow(g,1.55);
+    /* nudo: un engrosamiento pequeno justo en el remate, no un pie */
+    w += 0.030*Math.exp(-Math.pow((y+0.90)*7.0,2));
+  } else {
+    /* en los demas la recogida es minima: un globo apoyado no tiene cuello */
+    w *= 1.0 - f[0]*0.22*smooth(-0.45,-1.0,y);
+  }
+  return Math.max(w, 0.02);
+}
+function dist(px, py, kind, f, sag){
+  var soft = 1.0 - f[2];
+  px -= f[1]*py;
+  var halfH = 1.0 + sag*0.10 + (1.0-soft)*0.04;
+  var y = py/halfH;
+  if(Math.abs(y) >= 1.0) return 1.0 + (Math.abs(y)-1.0)*4.0 + Math.abs(px);
+  var w = perfil(y, kind, f);
+  /* el contorno es simplemente x = +-ancho(y): sumar la altura como si fuera una
+     elipse estrechaba la forma por los polos y sacaba picos */
+  var d = Math.abs(px)/w;
+  if(kind===2){
+    var yF = 0.982 + f[2]*0.012;
+    var dPlane = (-y)/yF;
+    d = smax(d, dPlane, 0.13);
+  }
+  return d;
+}
+function smooth(a,b,x){var t=Math.max(0,Math.min(1,(x-a)/(b-a)));return t*t*(3-2*t);}
+function draw(cx, cy, s, kind, f, sag, label){
+  g.beginPath();
+  for(var i=0;i<=360;i++){
+    var a=i/360*Math.PI*2, ux=Math.cos(a), uy=Math.sin(a);
+    /* se busca el radio en esa direccion resolviendo dist()=1 */
+    var lo=0.05, hi=2.6;
+    for(var k=0;k<26;k++){ var m=(lo+hi)/2; if(dist(ux*m,uy*m,kind,f,sag)<1) lo=m; else hi=m; }
+    var x=ux*lo, y=uy*lo;
+    if(i===0) g.moveTo(cx+x*s, cy-y*s); else g.lineTo(cx+x*s, cy-y*s);
+  }
+  g.closePath(); g.fillStyle='#e6d9d4'; g.fill(); g.strokeStyle='#6b5f64'; g.lineWidth=1.5; g.stroke();
+  g.fillStyle='#463d42'; g.font='13px sans-serif'; g.textAlign='center';
+  g.fillText(label, cx, cy+s*1.45+16);
+}
+g.fillStyle='#c9bfc6'; g.fillRect(0,0,1400,420);
+var y=175, s=105;
+draw(120,y,s,2,[0.10,-0.04,0.22],0.05,'apoyado poco inflado');
+draw(340,y,s,2,[0.10,0.00,0.80],0.05,'apoyado muy inflado');
+draw(560,y,s,2,[0.30,0.07,0.55],0.08,'apoyado, algo recogido');
+draw(780,y,s,1,[0.46,0.03,0.60],0.20,'colgante');
+draw(1000,y,s,0,[0.12,0.05,0.50],0.04,'esfera media');
