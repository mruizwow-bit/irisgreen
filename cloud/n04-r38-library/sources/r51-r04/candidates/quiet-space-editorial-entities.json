    {
      "entity_id": "quiet-space:m-06:en",
      "content_id": "quiet-space:m-06",
      "fragment_id": "quiet-space:m-06:en:main",
      "locale": "en",
      "content_type": "quiet_space",
      "title": "A shape that moves slowly",
      "heading": "M-06",
      "text": "Watch the shape\nJust watch it grow and shrink. You do not have to do anything else.\nBreathe with the shape (optional)\nIf you like, breathe in as it grows and breathe out slowly as it shrinks. If it bothers you, go back to “Watch the shape”.\nNormal pace\nSlower\nHow long\nNo end\n1 minute\n3 minutes\n5 minutes\nNo text\nStart\nStop\nThe shape has stopped. You can stay here.\nYou have reduced motion on: the shape does not move. You can move on yourself with “Next”.\nNext\nThe shape grows.\nThe shape shrinks.",
      "canonical_url": "https://irisgreen.eu/en/quiet-space/",
