+body.r46-page .ig-r42-shell {
+  margin: 0;
+  border-radius: var(--r46-radius);
+}
+body.r46-page .ig-r42-workspace {
+  padding: clamp(6px, .6vw, 12px);
+  background: var(--ig-bg-surface);
+}
+body.r46-page .ig-r42-stage {
+  background: var(--ig-bg-surface);
+  border-color: var(--ig-separator);
+  border-radius: calc(var(--r46-radius) - 4px);
+  padding: 0;
+}
+body.r46-page .ig-r42-stage > #r40Workspace { padding: 0; }
+body.r46-page .r46-panels { min-width: 0; }
+
+/* los modos viven en el contexto del shell: una fila, no una columna */
+body.r46-page .ig-r42-context { background: var(--ig-bg-surface); border-bottom-color: var(--ig-separator); }
